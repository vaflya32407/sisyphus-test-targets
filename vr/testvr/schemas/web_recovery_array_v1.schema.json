{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaflya32407/sisyphus-test-targets/vr/testvr/schemas/web_recovery_array_v1.schema.json",
  "title": "TestVR Web Recovery Array v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "record_id",
      "category",
      "quantity",
      "unit_price_cents"
    ],
    "properties": {
      "record_id": {
        "type": "string",
        "pattern": "^TVR-[0-9]{3}$"
      },
      "category": {
        "type": "string",
        "enum": ["alpha", "beta", "gamma"]
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "unit_price_cents": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      }
    }
  }
}
